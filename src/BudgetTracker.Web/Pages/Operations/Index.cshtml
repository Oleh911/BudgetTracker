@page
@model BudgetTracker.Web.Pages.Operations.IndexModel
@{
    ViewData["Title"] = "Operations";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>💸 Operations @(!string.IsNullOrEmpty(Model.BudgetName) ? $"- {Model.BudgetName}" : "")</h2>
    <a asp-page="/Operations/Create" asp-route-budgetId="@Model.BudgetId" class="btn btn-primary">+ Add Operation</a>
</div>

@if (!Model.Operations.Any())
{
    <div class="alert alert-info">
        No operations found. <a asp-page="/Operations/Create">Add your first operation</a>
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Category</th>
                <th>Amount</th>
                <th>Note</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var op in Model.Operations)
            {
                <tr>
                    <td>@op.OccurredAt.ToString("dd MMM yyyy HH:mm")</td>
                    <td>
                        @if (op.Kind == BudgetTracker.Domain.Enums.OperationKind.Expense)
                        {
                            <span class="badge bg-danger">Expense</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Income</span>
                        }
                    </td>
                    <td>@op.CategoryName → @op.SubcategoryName</td>
                    <td>@op.Amount.ToString("N2")</td>
                    <td>@(op.Note ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-page="/Budgets/Index" class="btn btn-secondary">Back to Budgets</a>