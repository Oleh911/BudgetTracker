@page
@model BudgetTracker.Web.Pages.Categories.IndexModel
@using BudgetTracker.Domain.Enums
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>?? Categories</h2>
        <div class="form-check mt-2">
            <input class="form-check-input" asp-for="IncludeArchived" onchange="this.form.submit()" form="filter-form" />
            <label class="form-check-label" asp-for="IncludeArchived">Show archived</label>
        </div>
    </div>
    <a asp-page="/Categories/Create" class="btn btn-primary">+ Create Category</a>
</div>

<form method="get" id="filter-form" class="d-none"></form>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (!Model.Categories.Any())
{
    <div class="alert alert-info">
        No categories found. <a asp-page="/Categories/Create">Create your first category</a>
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Kind</th>
                <th>Color</th>
                <th>Icon</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model.Categories)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>@category.Kind</td>
                    <td>@(category.Color ?? "-")</td>
                    <td>@(category.Icon ?? "-")</td>
                    <td>
                        @if (category.IsArchived)
                        {
                            <span class="badge bg-secondary">Archived</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-page="/Categories/Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        @if (!category.IsArchived)
                        {
                            <form method="post" asp-page-handler="Archive" class="d-inline">
                                <input type="hidden" name="id" value="@category.Id" />
                                <input type="hidden" name="IncludeArchived" value="@Model.IncludeArchived" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Archive</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-3">
    <a asp-page="/Subcategories/Index" class="btn btn-secondary">Manage Subcategories</a>
</div>