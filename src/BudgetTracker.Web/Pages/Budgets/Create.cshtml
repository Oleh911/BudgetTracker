@page
@model BudgetTracker.Web.Pages.Budgets.CreateModel
@{
    ViewData["Title"] = "Create Budget";
}

<h2>➕ Create New Budget</h2>

<form method="post" class="mt-4">
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Budget Name</label>
        <input asp-for="Name" class="form-control" placeholder="e.g., Monthly Budget" required />
    </div>

    <div class="mb-3">
        <label asp-for="AllocatedAmount" class="form-label">Allocated Amount</label>
        <input asp-for="AllocatedAmount" type="number" step="0.01" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Currency" class="form-label">Currency</label>
        <select asp-for="Currency" class="form-select" asp-items="Html.GetEnumSelectList<BudgetTracker.Domain.Enums.CurrencyCode>()"></select>
    </div>

    <div class="mb-3">
        <label asp-for="Note" class="form-label">Note (Optional)</label>
        <textarea asp-for="Note" class="form-control" rows="3"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Create Budget</button>
    <a asp-page="/Budgets/Index" class="btn btn-secondary">Cancel</a>
</form>