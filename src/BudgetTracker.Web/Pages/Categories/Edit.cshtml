@page "{id:guid}"
@model BudgetTracker.Web.Pages.Categories.EditModel
@{
    ViewData["Title"] = "Edit Category";
}

<h2>?? Edit Category</h2>

<form method="post" class="mt-4">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Kind" class="form-label">Kind</label>
        <select asp-for="Kind" class="form-select" asp-items="Html.GetEnumSelectList<BudgetTracker.Domain.Enums.CategoryKind>()"></select>
        <span asp-validation-for="Kind" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Color" class="form-label">Color</label>
        <input asp-for="Color" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Icon" class="form-label">Icon</label>
        <input asp-for="Icon" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-page="/Categories/Index" class="btn btn-secondary">Cancel</a>
</form>