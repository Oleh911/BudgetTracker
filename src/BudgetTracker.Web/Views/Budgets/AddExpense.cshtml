@model BudgetTracker.Web.Models.AddExpenseViewModel

@{
    ViewData["Title"] = $"Додати витрату — {Model.BudgetName}";
}

<h1 class="mb-4">Додати витрату: <em>@Model.BudgetName</em></h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="AddExpense" method="post">
            <input type="hidden" asp-for="BudgetId" />

            <div class="mb-3">
                <label asp-for="SubcategoryId" class="form-label">Підкатегорія</label>
                <select asp-for="SubcategoryId" asp-items="Model.Subcategories" class="form-select">
                    <option value="">— Оберіть підкатегорію —</option>
                </select>
                <span asp-validation-for="SubcategoryId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Amount" class="form-label">Сума</label>
                <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="OccurredAt" class="form-label">Дата і час</label>
                <input asp-for="OccurredAt" type="datetime-local" class="form-control"
                       value="@Model.OccurredAt.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="OccurredAt" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Note" class="form-label">Нотатка</label>
                <textarea asp-for="Note" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Note" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Зберегти</button>
                <a asp-action="Details" asp-route-id="@Model.BudgetId" class="btn btn-outline-secondary">Скасувати</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}