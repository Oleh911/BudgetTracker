{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information",
      "BudgetTracker": "Trace",
      "BudgetTracker.Web.Middleware": "Debug"
    }
  },
  "ConnectionStrings": {
    "BudgetTrackerDatabase": "Host=localhost;Port=5432;Database=budget_tracker;Username=postgres;Password=YOUR_PASSWORD;Timeout=30"
  },
  "Security": {
    "ApiKey": "dev-api-key-change-in-production"
  },
  "Features": {
    "EnableRequestLogging": true,
    "EnableResponseCompression": false
  }
}
